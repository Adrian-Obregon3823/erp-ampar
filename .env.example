# ==============================================
# Variables de Entorno - Proyecto AMPAR
# ==============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Ajusta los valores según tu servidor
# 3. Nunca subas el archivo .env a Git
#

# ===== Base de Datos Firebird =====
# Host de la base de datos (host.docker.internal para acceder al host desde Docker)
DB_HOST=

# Ruta completa a la base de datos en el HOST (no en el contenedor)
# Windows: C:/ruta/completa/AMPARJUL2.FDB
# Linux: /ruta/completa/AMPARJUL2.FDB
DB_PATH=

# Credenciales de Firebird
DB_USERNAME=
DB_PASSWORD=

# ===== Configuración de Correo =====
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_NAME=

# ===== Configuración General =====
# URL del sitio (ajusta el puerto si es necesario)
SITE_URL=

# Zona horaria
TIMEZONE=
