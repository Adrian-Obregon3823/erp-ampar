<Files ".env">
    Require all denied
</Files>

<IfModule mod_php.c>
  php_value max_input_vars 10000
  php_value max_multipart_body_parts 10000
</IfModule>
<IfModule mod_php7.c>
  php_value max_input_vars 10000
  php_value max_multipart_body_parts 10000
</IfModule>
<IfModule mod_php8.c>
  php_value max_input_vars 10000
  php_value max_multipart_body_parts 10000
</IfModule>
